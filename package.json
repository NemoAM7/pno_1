    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
